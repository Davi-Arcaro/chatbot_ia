# --- LLM local (Ollama) ---
# Endereco do servico Ollama. Em docker-compose o backend usa http://ollama:11434.
OLLAMA_URL=http://localhost:11434

# Modelo usado pelo chatbot. Alternativas: llama3.2:3b, qwen2.5:1.5b, phi3:mini.
# Quanto maior o modelo, melhor a qualidade e maior o uso de memoria.
OLLAMA_MODEL=llama3.2:1b

# Parametros de geracao.
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT=120

# --- Comportamento do chatbot ---
MAX_RESPONSE_WORDS=150
MAX_HISTORY_MESSAGES=20

# --- API ---
# Lista de origens (separadas por virgula) permitidas pelo CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
